node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Source footage stays local. Pushing raw clips would bloat the repo and
# GitHub rejects anything over 100MB anyway.
public/**/*.mov
public/**/*.MOV
public/**/*.mp4
public/**/*.MP4
public/**/*.m4v
public/**/*.webm

# Proxies are the exception: small enough to share, and how the edit gets
# reviewed remotely. The final render still uses the originals.
!public/proxies/**
